rules_version = '2';

// All Firestore access goes through the Next.js server (Firebase Admin SDK), which
// enforces authentication, ownership, timers and roles. Browsers get NO direct access:
// answer keys, other candidates' data and audit logs can never be read from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
