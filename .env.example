# Milliy Mock — copy to .env.local (local) and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values. The Supabase Vercel integration may already have set the Supabase ones for you.

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public browser key: "publishable" (sb_publishable_…) or legacy "anon" key — either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY secret key: "secret" (sb_secret_…) or legacy "service_role" key — either name works.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Your live site address (used in e-mail confirmation / password-reset links).
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ── Admin panel (/admin) ──────────────────────────────────────────────────────
# Generate both with:  npm run admin:hash -- "your-admin-code"
ADMIN_CODE_HASH=scrypt:<salt-hex>:<hash-hex>
ADMIN_SESSION_SECRET=<64-hex-characters>

# Optional: show "Continue with Google" (enable Google in Supabase → Authentication → Providers first)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
