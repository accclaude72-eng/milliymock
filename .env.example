# ─────────────────────────────────────────────────────────────────────────────
# Milliy Mock — environment template. Copy to .env.local and fill in.
# .env.local is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin access ─────────────────────────────────────────────────────────────
# The admin code is never stored in plain text. Generate both values with:
#   npm run admin:hash -- "your-admin-code"
ADMIN_CODE_HASH=scrypt:<salt-hex>:<hash-hex>
ADMIN_SESSION_SECRET=<64-hex-characters>

# ── Firebase Admin SDK (server only) ─────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the private key on ONE line with literal \n sequences, wrapped in quotes.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ── Firebase Web SDK (browser; these values are public by design) ────────────
# Firebase console → Project settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: "Continue with Google" button (enable the Google provider in Firebase Auth first)
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
