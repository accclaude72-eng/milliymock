# Local Firebase Emulator Suite settings — used ONLY by `npm run dev:emu`.
# Values here override .env.local for that command. No real credentials needed:
# "demo-" projects never touch Google Cloud.
FIREBASE_PROJECT_ID=demo-milliy-mock
FIREBASE_STORAGE_BUCKET=demo-milliy-mock.appspot.com
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-milliy-mock.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-milliy-mock
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-milliy-mock.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
